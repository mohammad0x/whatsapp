// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// جدول نشست‌ها (اکانت‌های واتساپ)
model Session {
  id        String   @id // مثلا: user_1
  phone     String?  // شماره موبایل متصل شده (مثلا: 98912...)
  status    String   @default("DISCONNECTED") // وضعیت: CONNECTED, SCAN_QR, ...
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  messages  Message[] // ارتباط با جدول پیام‌ها
}

// جدول پیام‌ها (تاریخچه چت)
model Message {
  id        Int      @id @default(autoincrement())
  text      String
  sender    String   // شماره فرستنده
  receiver  String   // شماره گیرنده
  isFromMe  Boolean  // آیا ما فرستادیم؟
  type      String   // text, image, ...
  createdAt DateTime @default(now())

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id])
}