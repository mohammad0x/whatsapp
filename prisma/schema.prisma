generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql" // تغییر از sqlite به postgresql
  url      = env("DATABASE_URL")
}

// 👤 جدول کاربران (برای ثبت نام)
model User {
  id        Int       @id @default(autoincrement())
  email     String    @unique
  password  String    // رمز عبور هش شده
  name      String?
  createdAt DateTime  @default(now())
  
  // ارتباط: هر کاربر چندین نشست واتساپ دارد
  sessions  Session[]
  keywords Keyword[]
}

model Session {
  id              String    @id
  status          String
  phone           String?
  webhookUrl      String?
  // ✅ فیلد جدید برای پاسخ پیش‌فرض
  defaultResponse String?   @default("متاسفانه متوجه نشدم. لطفا یکی از گزینه‌های منو را انتخاب کنید یا کلمه 'سلام' را بفرستید.")
  userId          Int
  user            User      @relation(fields: [userId], references: [id])
  createdAt       DateTime  @default(now())
  messages        Message[]
}

// 💬 جدول پیام‌ها
model Message {
  id        Int      @id @default(autoincrement())
  text      String
  sender    String
  receiver  String
  isFromMe  Boolean
  type      String
  createdAt DateTime @default(now())

  sessionId String
  session   Session @relation(fields: [sessionId], references: [id])
}

model Keyword {
  id        Int      @id @default(autoincrement())
  trigger   String   // اصلاح شد: String با S بزرگ
  response  String   
  userId    Int      
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, trigger]) 
}
