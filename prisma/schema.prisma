generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int       @id @default(autoincrement())
  email           String    @unique
  password        String    
  name            String?
  role            String    @default("ADMIN") // مقادیر: 'ADMIN', 'AGENT'
  
  plan            String    @default("FREE") 
  subscriptionEnd DateTime?
  isActive        Boolean   @default(true)
  
  createdAt       DateTime  @default(now())

  sessions        Session[] 
  keywords        Keyword[] 
  agents          Agent[]   
  cannedResponses CannedResponse[] 
}

model Session {
  id              String    @id
  status          String    
  phone           String?
  webhookUrl      String?
  defaultResponse String?   @default("متاسفانه متوجه نشدم. لطفا 'سلام' را بفرستید.")
  
  userId          Int
  user            User      @relation(fields: [userId], references: [id])
  
  conversations   Conversation[] 
  createdAt       DateTime  @default(now())
}

model Agent {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  role      String   @default("AGENT") 
  isOnline  Boolean  @default(false)
  avatar    String?
  signature String?  
  
  userId    Int      
  user      User     @relation(fields: [userId], references: [id])

  assignedConversations Conversation[] 
  createdAt DateTime @default(now())
}

model CannedResponse {
  id        Int      @id @default(autoincrement())
  shortcut  String   
  content   String   
  
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
}

model Contact {
  id          Int      @id @default(autoincrement())
  phone       String   @unique 
  pushName    String?
  name        String?  
  avatarUrl   String?
  email       String?
  
  tags        Tag[]    
  notes       Note[]   
  
  conversations Conversation[]
  createdAt   DateTime @default(now())
}

model Conversation {
  id          Int       @id @default(autoincrement())
  status      String    @default("OPEN") 
  priority    String    @default("MEDIUM") 
  unreadCount Int       @default(0)
  
  contactId   Int
  contact     Contact   @relation(fields: [contactId], references: [id])
  
  sessionId   String
  session     Session   @relation(fields: [sessionId], references: [id])
  
  assignedTo  Int?
  agent       Agent?    @relation(fields: [assignedTo], references: [id])
  
  messages    Message[] 
  
  lastMessageAt DateTime @default(now()) 
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// 📨 پیام (آپدیت شده)
model Message {
  id        Int      @id @default(autoincrement())
  text      String?
  type      String   
  
  sender    String   
  receiver  String   
  isFromMe  Boolean
  
  mediaUrl  String?
  caption   String?

  // 👇👇 این خط جدید و حیاتی است 👇👇
  whatsappId String? @unique  
  
  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  createdAt DateTime @default(now())
}

model Tag {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  color     String    @default("#000000")
  contacts  Contact[]
}

model Note {
  id        Int      @id @default(autoincrement())
  text      String
  author    String?  
  
  contactId Int
  contact   Contact  @relation(fields: [contactId], references: [id])
  
  createdAt DateTime @default(now())
}

model Keyword {
  id        Int      @id @default(autoincrement())
  trigger   String
  response  String
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  
  createdAt DateTime @default(now())
  @@unique([userId, trigger])
}